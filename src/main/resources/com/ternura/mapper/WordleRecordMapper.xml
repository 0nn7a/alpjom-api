<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 上述為 MyBatis 固定標頭資料，不需修改 -->

<mapper namespace="com.ternura.mapper.WordleRecordMapper">
    <select id="selectByCondition" resultType="com.ternura.model.entity.WordleRecord">
        SELECT * FROM wordle_record
        <where>
            <if test="userId != null">
                AND user_id = #{userId}
            </if>
            <if test="mode != null">
                AND mode = #{mode}
            </if>
            <if test="difficulty != null">
                AND difficulty = #{difficulty}
            </if>
            <choose>
                <when test="isWin == @com.ternura.model.enums.WordleIsWin@ONGOING">
                    AND is_win IS NULL
                </when>
                <when test="isWin == @com.ternura.model.enums.WordleIsWin@WIN">
                    AND is_win = true
                </when>
                <when test="isWin == @com.ternura.model.enums.WordleIsWin@LOSE">
                    AND is_win = false
                </when>
                <when test="isWin == @com.ternura.model.enums.WordleIsWin@FINISHED">
                    AND is_win IS NOT NULL
                </when>
            </choose>
            <if test="date != null">
                AND date = #{date}
            </if>
        </where>
        ORDER BY created_at
    </select>

    <select id="selectHeatmapByUser" resultType="com.ternura.model.vo.HeatmapVO">
        SELECT DATE(date) date, COUNT(1) count
        FROM wordle_record
        WHERE user_id = #{userId} AND is_win IS NOT NULL
        GROUP BY DATE(date)
        ORDER BY date
    </select>
</mapper>